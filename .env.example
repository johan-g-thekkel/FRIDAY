# Copy this file to .env and add your own Token Factory key.
# Never commit .env or paste API keys into chat.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Set this to an exact model ID available in your Token Factory account.
NEBIUS_MODEL=
APP_ENV=development
SQLITE_PATH=./data/teddy.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Claude Fable 5.1 reasoning route.
# Disabled by default; only selected for qualifying complex tasks when enabled.
# Do not commit .env or share credentials in chat.
ANTHROPIC_API_KEY=
CLAUDE_FABLE_MODEL=claude-fable-5-1
CLAUDE_FABLE_ENABLED=false
CLAUDE_FABLE_MAX_OUTPUT_TOKENS=900
CLAUDE_FABLE_MAX_PROMPT_CHARS=8000
CLAUDE_FABLE_MAX_ESTIMATED_COST_USD=0.10

# Local, reviewed skill folders to index. Imported skills are disabled by default.
SKILLS_ROOT=./skills/imported
